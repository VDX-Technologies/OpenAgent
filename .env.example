# VDX OpenAgent — Environment Variables Template
# Copy to `.env` and fill in your values. NEVER commit `.env`.

# ── Ollama (local LLM) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=120
# Context window in tokens (0 = auto: 16384 on 32 GB+ Macs, 8192 below)
OLLAMA_NUM_CTX=0
# Keep the model loaded this long after a request (avoids slow reloads)
OLLAMA_KEEP_ALIVE=30m

# ── Discord Bot ──────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_PREFIX=!
DISCORD_ALLOWED_USERS=

# ── Gmail SMTP ───────────────────────────────────────────────────────
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# ── WhatsApp (optional Cloud API; otherwise opens WhatsApp Desktop) ─
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── GitHub / coding agent ───────────────────────────────────────
GITHUB_TOKEN=
CODE_WORKSPACE=

# ── Connectors (comma-separated ids to disable) ─────────────────────
CONNECTORS_DISABLED=

# ── Database ─────────────────────────────────────────────────────────
# DB_PATH=data/memory.db

# ── Anonymous telemetry (opt-in, asked in the app) ───────────────────
# VDX Core push endpoint + write-only source token. Leave empty to disable.
VDX_TELEMETRY_URL=
